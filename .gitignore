# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
delfos-*.tar

# Elixir Lang Server artifacts
.elixir_ls/

# BEAM compiled files
*.beam

# Dialyzer PLT files
*.plt

# Hex search index
.hex/

# Local DB dumps / fixtures
priv/repo/*.sql
priv/repo/*.dump

# OS junk
.DS_Store
Thumbs.db

# Opencode toolchain artifacts (RTK instructions etc.)
AGENTS.md

# Batamanta-generated binary
/delfos

# Rust build artifacts (NIF crate)
native/tree_sitter_nif/target/
/native/tree_sitter_nif/target/
# Cargo lock+info for the NIF crate (regenerable from Cargo.toml)
native/tree_sitter_nif/Cargo.lock
native/**/*.rustc_info.json
# Compiled NIF artifacts (regenerable from source)
priv/native/*.so
priv/native/*.dylib
priv/native/*.dll


# --- Dialyzer PLTs ---
/priv/plts/
graphify-out/
.specify/

# xref graph dumps (build artifact from mix xref)
xref_graph.dot
xref_graph.dot.bak

# Local Spanish TEST_PLAN draft (translation WIP, not source)
TEST_PLAN.md
